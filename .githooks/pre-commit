#!/usr/bin/env bash
# formality pre-commit hook
# Activated via: git config core.hooksPath .githooks
# Or automatically during project setup: fml init sets this up for you.
set -euo pipefail

if [ -x "./target/debug/fml" ]; then
  FML="./target/debug/fml"
elif [ -x "./target/debug/fml.exe" ]; then
  FML="./target/debug/fml.exe"
else
  FML="fml"
fi

"$FML" fmt --staged
"$FML" lint --staged

