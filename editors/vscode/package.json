{
  "name": "formality",
  "displayName": "Formality",
  "description": "One formatter and linter orchestrator across every language you touch",
  "version": "0.2.1",
  "publisher": "arvinduh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "format",
    "lint",
    "rust",
    "python",
    "cpp",
    "markdown",
    "yaml",
    "json",
    "toml",
    "typst",
    "java",
    "go",
    "kotlin",
    "javascript",
    "typescript"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:python",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:markdown",
    "onLanguage:yaml",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:toml",
    "onLanguage:typst",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:kotlin",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:formality.formatWorkspace",
    "onCommand:formality.lintWorkspace",
    "onCommand:formality.lintFix",
    "onCommand:formality.sync",
    "onCommand:formality.doctor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "formality.formatWorkspace",
        "title": "Formality: Format Entire Workspace",
        "category": "Formality"
      },
      {
        "command": "formality.lintWorkspace",
        "title": "Formality: Lint Entire Workspace",
        "category": "Formality"
      },
      {
        "command": "formality.lintFix",
        "title": "Formality: Fix Workspace (Lint Fixes + Format)",
        "category": "Formality"
      },
      {
        "command": "formality.sync",
        "title": "Formality: Sync Native Configs",
        "category": "Formality"
      },
      {
        "command": "formality.doctor",
        "title": "Formality: Run Toolchain Doctor",
        "category": "Formality"
      }
    ],
    "configuration": {
      "title": "Formality",
      "properties": {
        "formality.executablePath": {
          "type": "string",
          "default": "fml",
          "description": "Path to the fml binary (defaults to 'fml' in PATH)"
        },
        "formality.autoSyncOnConfigSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run 'fml sync' whenever formality.toml (or .formality.toml) is saved or created. Disable this if you prefer to run 'fml sync' manually or if native config files are managed outside of formality."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "mocha out/test/unit/**/*.test.js",
    "test:integration": "node ./out/test/runTest.js",
    "test": "npm run compile && npm run lint && npm run test:unit && npm run test:integration",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "package": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0"
  }
}
