{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormalityConfig",
  "type": "object",
  "properties": {
    "global": {
      "anyOf": [
        {
          "$ref": "#/$defs/GlobalConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "lang": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LangConfig"
      }
    }
  },
  "$defs": {
    "CppOptions": {
      "description": "Typed formatting and linting options for C/C++.",
      "type": "object",
      "properties": {
        "based_on_style": {
          "type": ["string", "null"]
        },
        "break_before_braces": {
          "type": ["string", "null"]
        },
        "column_limit": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "pointer_alignment": {
          "type": ["string", "null"]
        },
        "sort_includes": {
          "type": ["boolean", "null"]
        },
        "standard": {
          "type": ["string", "null"]
        }
      }
    },
    "GlobalConfig": {
      "type": "object",
      "properties": {
        "charset": {
          "type": ["string", "null"]
        },
        "end_of_line": {
          "type": ["string", "null"]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignore_languages": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "indent_size": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "insert_final_newline": {
          "type": ["boolean", "null"]
        },
        "languages": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutFacet"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_length": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "trim_trailing_whitespace": {
          "type": ["boolean", "null"]
        },
        "use_tabs": {
          "type": ["boolean", "null"]
        }
      }
    },
    "GoOptions": {
      "description": "Typed formatting and linting options for Go.",
      "type": "object",
      "properties": {
        "linters": {
          "description": "Linters to enable in the generated `.golangci.yml`. Defaults to\ngolangci-lint's own well-known default set when unset.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "local_prefixes": {
          "description": "Prefix(es) passed to `goimports -local` so first-party imports are\ngrouped separately from third-party ones (e.g. \"example.com/myorg\").",
          "type": ["string", "null"]
        }
      }
    },
    "JavaScriptOptions": {
      "description": "Typed formatting and linting options for JavaScript/TypeScript (Biome).",
      "type": "object",
      "properties": {
        "organize_imports": {
          "type": ["boolean", "null"]
        },
        "quote_style": {
          "type": ["string", "null"]
        },
        "semicolons": {
          "type": ["string", "null"]
        },
        "trailing_comma": {
          "type": ["string", "null"]
        }
      }
    },
    "JsonOptions": {
      "description": "Typed formatting and linting options for JSON.",
      "type": "object"
    },
    "KotlinOptions": {
      "description": "Typed formatting and linting options for Kotlin.\n\nKotlin's tooling (ktlint) reads layout facets (indent size, line length,\netc.) exclusively from `.editorconfig` rather than a dedicated config\nfile, so this struct is intentionally empty for now — it exists to keep\nKotlin consistent with the rest of the fleet's per-language options\nwiring and as a home for future knobs (e.g. `ktlint_code_style`).",
      "type": "object"
    },
    "LangConfig": {
      "type": "object",
      "properties": {
        "cpp": {
          "anyOf": [
            {
              "$ref": "#/$defs/CppOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": ["boolean", "null"]
        },
        "exclude": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "extra_args": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "format_tool": {
          "type": ["string", "null"]
        },
        "go": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "indent_size": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "javascript": {
          "anyOf": [
            {
              "$ref": "#/$defs/JavaScriptOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "json": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "kotlin": {
          "anyOf": [
            {
              "$ref": "#/$defs/KotlinOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutFacet"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_length": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "lint_tool": {
          "type": ["string", "null"]
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkdownOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "prose_wrap": {
          "type": ["string", "null"]
        },
        "python": {
          "anyOf": [
            {
              "$ref": "#/$defs/PythonOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "rust": {
          "anyOf": [
            {
              "$ref": "#/$defs/RustOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "toml": {
          "anyOf": [
            {
              "$ref": "#/$defs/TomlOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "typst": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypstOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "use_tabs": {
          "type": ["boolean", "null"]
        },
        "yaml": {
          "anyOf": [
            {
              "$ref": "#/$defs/YamlOptions"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LayoutFacet": {
      "description": "Common layout facets configuring formatting layout across tools.",
      "type": "object",
      "properties": {
        "indent_size": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "line_length": {
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "prose_wrap": {
          "type": ["string", "null"]
        },
        "use_tabs": {
          "type": ["boolean", "null"]
        }
      }
    },
    "MarkdownOptions": {
      "description": "Typed formatting and linting options for Markdown.",
      "type": "object",
      "properties": {
        "prose_wrap": {
          "type": ["string", "null"]
        }
      }
    },
    "PythonOptions": {
      "description": "Typed formatting and linting options for Python.",
      "type": "object",
      "properties": {
        "quote_style": {
          "type": ["string", "null"]
        },
        "target_version": {
          "type": ["string", "null"]
        }
      }
    },
    "RustOptions": {
      "description": "Typed formatting and linting options for Rust.",
      "type": "object",
      "properties": {
        "edition": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        }
      }
    },
    "TomlOptions": {
      "description": "Typed formatting and linting options for TOML.",
      "type": "object"
    },
    "TypstOptions": {
      "description": "Typed formatting and linting options for Typst.",
      "type": "object"
    },
    "YamlOptions": {
      "description": "Typed formatting and linting options for YAML.",
      "type": "object",
      "properties": {
        "document_start": {
          "type": ["boolean", "null"]
        },
        "indent_sequence": {
          "type": ["boolean", "null"]
        },
        "truthy": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
