{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormalityConfig",
  "description": "Root formality configuration structure matching `formality.toml`.",
  "type": "object",
  "properties": {
    "global": {
      "description": "Global defaults block (`[global]`).",
      "anyOf": [
        {
          "$ref": "#/$defs/GlobalConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "lang": {
      "description": "Per-language surface configuration map (`[lang.<name>]`).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LangConfig"
      }
    }
  },
  "$defs": {
    "CppOptions": {
      "description": "Typed formatting and linting options for C/C++.",
      "type": "object",
      "properties": {
        "based_on_style": {
          "description": "Base clang-format style (e.g. `\"Google\"`).",
          "type": ["string", "null"]
        },
        "break_before_braces": {
          "description": "Brace breaking style.",
          "type": ["string", "null"]
        },
        "column_limit": {
          "description": "Column limit for line wrapping.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "pointer_alignment": {
          "description": "Pointer alignment style (`\"Left\"`, `\"Right\"`, or `\"Middle\"`).",
          "type": ["string", "null"]
        },
        "sort_includes": {
          "description": "Whether to sort `#include` directives alphabetically.",
          "type": ["boolean", "null"]
        },
        "standard": {
          "description": "C++ language standard version (e.g. `\"c++20\"`).",
          "type": ["string", "null"]
        }
      }
    },
    "GlobalConfig": {
      "description": "Global default settings applicable across all language surfaces.",
      "type": "object",
      "properties": {
        "charset": {
          "description": "Default file encoding charset (e.g. `\"utf-8\"`).",
          "type": ["string", "null"]
        },
        "end_of_line": {
          "description": "Default line ending format (`\"lf\"` or `\"crlf\"`).",
          "type": ["string", "null"]
        },
        "exclude": {
          "description": "Global file path exclude patterns.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignore_languages": {
          "description": "List of language surface names to ignore/skip.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "indent_size": {
          "description": "Default indentation width (spaces).",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "insert_final_newline": {
          "description": "Whether files should end with a trailing newline.",
          "type": ["boolean", "null"]
        },
        "languages": {
          "description": "Explicit list of active language surface names to manage.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "description": "Optional layout facet settings override.",
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutFacet"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_length": {
          "description": "Default maximum line length.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "trim_trailing_whitespace": {
          "description": "Whether trailing whitespace on lines should be trimmed.",
          "type": ["boolean", "null"]
        },
        "use_tabs": {
          "description": "Whether to use tabs instead of spaces for indentation.",
          "type": ["boolean", "null"]
        }
      }
    },
    "GoOptions": {
      "description": "Typed formatting and linting options for Go.",
      "type": "object",
      "properties": {
        "linters": {
          "description": "Linters to enable in the generated `.golangci.yml`. Defaults to\ngolangci-lint's own well-known default set when unset.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "local_prefixes": {
          "description": "Prefix(es) passed to `goimports -local` so first-party imports are\ngrouped separately from third-party ones (e.g. \"example.com/myorg\").",
          "type": ["string", "null"]
        }
      }
    },
    "JavaOptions": {
      "description": "Typed formatting and linting options for Java.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Formatting style used by google-java-format: \"google\" (default,\n2-space indent) or \"aosp\" (4-space indent).",
          "type": ["string", "null"]
        }
      }
    },
    "JavaScriptOptions": {
      "description": "Typed formatting and linting options for JavaScript/TypeScript (Biome).",
      "type": "object",
      "properties": {
        "organize_imports": {
          "description": "Whether to automatically organize import statements.",
          "type": ["boolean", "null"]
        },
        "quote_style": {
          "description": "Preferred string quote style (`\"single\"` or `\"double\"`).",
          "type": ["string", "null"]
        },
        "semicolons": {
          "description": "Semicolon policy (`\"always\"` or `\"as-needed\"`).",
          "type": ["string", "null"]
        },
        "trailing_comma": {
          "description": "Trailing comma policy (`\"all\"`, `\"es5\"`, or `\"none\"`).",
          "type": ["string", "null"]
        }
      }
    },
    "JsonOptions": {
      "description": "Typed formatting and linting options for JSON.",
      "type": "object"
    },
    "KotlinOptions": {
      "description": "Typed formatting and linting options for Kotlin.\n\nKotlin's tooling (ktlint) reads layout facets (indent size, line length,\netc.) exclusively from `.editorconfig` rather than a dedicated config\nfile, so this struct is intentionally empty for now — it exists to keep\nKotlin consistent with the rest of the fleet's per-language options\nwiring and as a home for future knobs (e.g. `ktlint_code_style`).",
      "type": "object"
    },
    "LangConfig": {
      "description": "Per-language configuration section (`[lang.<surface>]`).",
      "type": "object",
      "properties": {
        "cpp": {
          "description": "C/C++ surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/CppOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "description": "Whether this language surface is enabled.",
          "type": ["boolean", "null"]
        },
        "exclude": {
          "description": "Explicit file pattern exclusions for this surface.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "extra_args": {
          "description": "Additional command-line arguments to pass to the underlying tool.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "files": {
          "description": "Explicit file pattern inclusions for this surface.",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "format_tool": {
          "description": "Custom formatter tool binary or command name override.",
          "type": ["string", "null"]
        },
        "go": {
          "description": "Go surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/GoOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "indent_size": {
          "description": "Per-language indentation size override.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "java": {
          "description": "Java surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/JavaOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "javascript": {
          "description": "JavaScript/TypeScript surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/JavaScriptOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "json": {
          "description": "JSON surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/JsonOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "kotlin": {
          "description": "Kotlin surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/KotlinOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "description": "Surface layout facet configuration.",
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutFacet"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_length": {
          "description": "Per-language line length override.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "lint_tool": {
          "description": "Custom linter tool binary or command name override.",
          "type": ["string", "null"]
        },
        "markdown": {
          "description": "Markdown surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/MarkdownOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "prose_wrap": {
          "description": "Prose wrapping strategy (for Markdown, etc.).",
          "type": ["string", "null"]
        },
        "python": {
          "description": "Python surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/PythonOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "rust": {
          "description": "Rust surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/RustOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "toml": {
          "description": "TOML surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/TomlOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "typst": {
          "description": "Typst surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/TypstOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "use_tabs": {
          "description": "Whether to use tabs for indentation in this surface.",
          "type": ["boolean", "null"]
        },
        "yaml": {
          "description": "YAML surface specific options.",
          "anyOf": [
            {
              "$ref": "#/$defs/YamlOptions"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LayoutFacet": {
      "description": "Common layout facets configuring formatting layout across tools.",
      "type": "object",
      "properties": {
        "indent_size": {
          "description": "Indentation size in spaces.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "line_length": {
          "description": "Maximum line length limit.",
          "type": ["integer", "null"],
          "format": "uint",
          "minimum": 0
        },
        "prose_wrap": {
          "description": "Prose wrapping strategy string.",
          "type": ["string", "null"]
        },
        "use_tabs": {
          "description": "Whether to use tabs for indentation.",
          "type": ["boolean", "null"]
        }
      }
    },
    "MarkdownOptions": {
      "description": "Typed formatting and linting options for Markdown.",
      "type": "object",
      "properties": {
        "prose_wrap": {
          "description": "Prose wrapping strategy string (`\"always\"`, `\"never\"`, or `\"preserve\"`).",
          "type": ["string", "null"]
        }
      }
    },
    "PythonOptions": {
      "description": "Typed formatting and linting options for Python.",
      "type": "object",
      "properties": {
        "ignore_rules": {
          "description": "Ruff lint rules to ignore (e.g. `[\"E501\", \"F401\"]`).",
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "quote_style": {
          "description": "Quote style for strings (`\"single\"` or `\"double\"`).",
          "type": ["string", "null"]
        },
        "target_version": {
          "description": "Python target version (e.g. `\"py310\"`).",
          "type": ["string", "null"]
        }
      }
    },
    "RustOptions": {
      "description": "Typed formatting and linting options for Rust.",
      "type": "object",
      "properties": {
        "edition": {
          "description": "Rust edition (e.g. `\"2021\"`).",
          "type": ["string", "null"]
        }
      }
    },
    "TomlOptions": {
      "description": "Typed formatting and linting options for TOML.",
      "type": "object",
      "properties": {
        "align_entries": {
          "description": "Whether to align entries across lines.",
          "type": ["boolean", "null"]
        },
        "indent_entries": {
          "description": "Whether to indent table entry keys.",
          "type": ["boolean", "null"]
        },
        "indent_tables": {
          "description": "Whether to indent table contents.",
          "type": ["boolean", "null"]
        }
      }
    },
    "TypstOptions": {
      "description": "Typed formatting and linting options for Typst.",
      "type": "object"
    },
    "YamlOptions": {
      "description": "Typed formatting and linting options for YAML.",
      "type": "object",
      "properties": {
        "document_start": {
          "description": "Whether to require `---` document start markers.",
          "type": ["boolean", "null"]
        },
        "indent_sequence": {
          "description": "Whether to indent sequence items under mapping keys.",
          "type": ["boolean", "null"]
        },
        "truthy": {
          "description": "Whether to enforce strict boolean truthy values.",
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
